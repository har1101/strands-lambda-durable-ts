{
  "name": "strands-lambda-durable",
  "version": "0.1.0",
  "description": "Run Strands Agents (TypeScript) on AWS Lambda durable functions: one durable step per model call and tool use, human-in-the-loop via durable callbacks.",
  "keywords": [
    "strands-agents",
    "aws-lambda",
    "durable-functions",
    "durable-execution",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws/durable-execution-sdk-js": ">=2.4.0 <3",
    "@strands-agents/sdk": ">=1.18.0 <2",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws/durable-execution-sdk-js": "^2.4.0",
    "@aws/durable-execution-sdk-js-testing": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strands-agents/sdk": "^1.18.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
